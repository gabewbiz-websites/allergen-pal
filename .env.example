# Copy to `.env` and fill in. All are optional — with none set, the app runs
# fully in local/guest mode with simulated billing (great for development).

# --- Cloud sync (Supabase) ---------------------------------------------------
# From Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Billing -----------------------------------------------------------------
# "simulated" (default) exercises the whole freemium→paid lifecycle locally.
# Switch to "stripe" to take real money (requires the values below + Supabase).
VITE_BILLING_PROVIDER=simulated

# Supabase Edge Functions base URL, e.g.
# https://<project-ref>.supabase.co/functions/v1
VITE_FUNCTIONS_URL=

# Stripe Price IDs (test mode), from Stripe → Products.
VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_YEARLY=

# ---------------------------------------------------------------------------
# The following are set as SECRETS on the Supabase Edge Functions, NOT here
# (never ship secret keys to the browser):
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   STRIPE_PRICE_MONTHLY
#   STRIPE_PRICE_YEARLY
#   SUPABASE_URL                (auto-provided to functions)
#   SUPABASE_SERVICE_ROLE_KEY   (auto-provided to functions)
